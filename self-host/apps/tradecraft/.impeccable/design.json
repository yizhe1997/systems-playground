  "narrative": {
    "northStar": "The Lab Notebook",
    "overview": "A calm notebook where you check your own work: warm parchment, violet-black ink, thin rules, small soft shadows. The loudest thing on the page is what you wrote and judged, never the profit figure. Comfortable density, light primary, night matching.",
    "keyCharacteristics": [
      "Warm near-white paper, never pure white or black.",
      "One ink and one quiet accent.",
      "Outlined primary buttons; filled only for a selected choice.",
      "Profit and loss tinted on the figure alone, always with a sign."
    ],
    "rules": [
      {
        "name": "The Quiet Outcome Rule",
        "body": "Profit and loss colour only on the text of a net-result figure; never rows, borders, icons or R.",
        "section": "colors"
      },
      {
        "name": "The Words Before Colour Rule",
        "body": "Every signed figure keeps its sign or a word; colour is only a hint.",
        "section": "colors"
      },
      {
        "name": "The One Ink Rule",
        "body": "One text family, one accent, never a button fill.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "All text at least 4.5:1 in both modes; the reference grey #89828d fails, so Plum Ash is used.",
        "section": "colors"
      },
      {
        "name": "The No Display Rule",
        "body": "No hero or display type; the title at 24px is the largest.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the primary button outlined with a 1px Plum Charcoal border and 3px radius.",
      "Do tint a net-result figure and keep its sign.",
      "Do write errors and dash reasons in words.",
      "Do use tabular figures for money, size and R."
    ],
    "donts": [
      "Don't fill a button with the accent.",
      "Don't colour rows, borders, icons or R.",
      "Don't use radii above 6px or any gradient.",
      "Don't add display or serif type."
    ]
  }
}