# Copy to .env and fill in. Never commit .env.
# Local development only: everything is published on 127.0.0.1.
POSTGRES_PASSWORD=
# Sign-in (feature 002). Never commit values. Generate each secret with: openssl rand -base64 48
# The address you open the app at, no trailing slash (the Google redirect addresses are built from it)
NEXTAUTH_URL=
# At least 32 bytes. Encrypts the session cookie
NEXTAUTH_SECRET=
# At least 32 bytes, different from the one above. Signs the web tier's calls to the API
SERVICE_TOKEN_SECRET=
# Your own Google email; becomes the first identity (also the way back in if every identity is disabled)
OWNER_BOOTSTRAP_EMAIL=
# From the Google Cloud console (OAuth client, Web application). Empty until you have them: sign-in then refuses
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# production (the default when unset), local or test
TRADECRAFT_ENV=production
# Local and test only: lets a script make a session cookie without Google. The apps refuse to start with
# this set while TRADECRAFT_ENV is production
DEV_SESSION_SECRET=
# Optional host ports
# POSTGRES_HOST_PORT=5435
# BACKEND_HOST_PORT=8081
# FRONTEND_HOST_PORT=3100
