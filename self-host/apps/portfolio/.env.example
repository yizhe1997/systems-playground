# Server-to-server auth between the frontend BFF and the Go backend (see adrs/002-bff-proxy-security.md)
ADMIN_API_KEY=your_secure_base64_key

# Resume email delivery (Google App Password)
SMTP_EMAIL=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Optional Discord webhook for new resume-request notifications
RESUME_WEBHOOK_URL=https://discord.com/api/webhooks/...

# AI triage for incoming resume requests (deepseek/deepseek-v4-flash-0731 via OpenRouter,
# with provider.zdr=true + provider.ignore=["deepseek"] - see backend/triage.go)
OPENROUTER_API_KEY=sk-or-v1-...

# Filebrowser (secure resume PDF distribution) - see adrs/003-secure-resume-storage.md
FILEBROWSER_PUBLIC_URL=http://localhost:8088
FILEBROWSER_ADMIN_USERNAME=admin
FILEBROWSER_ADMIN_PASSWORD=admin

# Base URL the backend links to in emails (e.g. the resume-status tracking link).
# Defaults to http://localhost:8086 if unset - only need to set this for a non-default local port.
FRONTEND_PUBLIC_URL=http://localhost:8086
