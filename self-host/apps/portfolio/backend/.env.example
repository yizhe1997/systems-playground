# Server-to-Server Authentication (Matches frontend)
ADMIN_API_KEY=your_secure_base64_key

# Resume Email Integration (Google App Password)
SMTP_EMAIL=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Optional Discord Webhook for instant notification
RESUME_WEBHOOK_URL=https://discord.com/api/webhooks/...

# AI triage for incoming resume requests (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database path (defaults to ./data/portfolio.db if unset; the compose
# setup points this at a mounted volume instead)
SQLITE_PATH=./data/portfolio.db

# Filebrowser Configuration (for secure PDF links)
FILEBROWSER_PUBLIC_URL=https://files.yourdomain.com
FILEBROWSER_ADMIN_USERNAME=admin
FILEBROWSER_ADMIN_PASSWORD=admin
