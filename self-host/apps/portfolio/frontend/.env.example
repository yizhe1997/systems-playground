# NextAuth Configuration
# (Run `openssl rand -base64 32` to generate a strong secret)
NEXTAUTH_SECRET=
# E.g., http://localhost:8086 locally, or https://portfolio.38569123.xyz in prod
NEXTAUTH_URL=http://localhost:8086

# Google SSO Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to access the admin dashboard
ADMIN_EMAILS=test@gmail.com,test2@gmail.com

# ⚠️ DEV ONLY - NEVER set this in a deployed/production environment.
# Registers an additional passwordless "Dev Login" sign-in method on
# /admin/login, for local UI work when going through real Google OAuth isn't
# practical. It's an extra provider, not a bypass of the real one - Google
# SSO keeps working exactly as before either way. Leave unset/false normally;
# only flip it on in your own local .env when you need it. (Also hard-gated
# on NODE_ENV!==production in code, so it can never activate in a real deploy.)
# NEXT_PUBLIC_DEV_LOGIN_ENABLED=true

# =========================================================
# Server-to-Server Authentication (Next.js -> Golang API)
# =========================================================

# Generate a strong pre-shared key (e.g. `openssl rand -base64 32`)
ADMIN_API_KEY=
