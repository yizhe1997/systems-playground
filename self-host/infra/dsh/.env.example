# Environment variables for DeepSeek Harness (dsh) — local runs only.
# In the deployed stack the keys come from Infisical and HOST from a GitHub repo variable.
# Copy to .env and fill in real values — .env is gitignored, this file is not.

# Held by the gateway container only; dsh itself never sees them. Use dedicated keys with spend limits.
OPENROUTER_API_KEY=
# Prepaid API credit from console.anthropic.com. A Claude subscription cannot be used here.
ANTHROPIC_API_KEY=

# Your domain (e.g. example.com). When set, dsh is published at <DSH_SUBDOMAIN or dsh>.<HOST> through the tunnel,
# and dsh trusts that Host. Leave empty locally, and until the hostname's Cloudflare Access policy exists.
HOST=
# Optional subdomain override (default: dsh).
DSH_SUBDOMAIN=

# Optional origin check, both or neither. Zero Trust team name (the <team> in <team>.cloudflareaccess.com) and the dsh
# Access application's Audience (AUD) tag (Access controls > Applications > Configure > Additional settings). With
# both set, cloudflared itself rejects requests that did not pass Access. Repository variables in the deployed stack.
CF_ACCESS_TEAM=
DSH_ACCESS_AUD=

# Host loopback port the gateway publishes (default 3080).
DSH_PORT=

# Host folder the agent may read and write (default ./workspaces next to this file).
DSH_WORKSPACES_DIR=
