# Environment variables for DeepSeek Harness (dsh) — local runs only.
# In the deployed stack the keys come from Infisical and HOST from a GitHub repo variable.
# Copy to .env and fill in real values — .env is gitignored, this file is not.

# Held by the gateway container only; dsh itself never sees them. Use dedicated keys with spend limits.
OPENROUTER_API_KEY=
# Prepaid API credit from console.anthropic.com. A Claude subscription cannot be used here.
ANTHROPIC_API_KEY=

# MCP hub (LiteLLM). All three are secrets held by the litellm/litellm-db containers only. Generate each with
# openssl rand -hex 32 (prefix the first two with sk-). The salt key encrypts the tokens stored in the database:
# keep it, because changing it makes them unreadable. They are required: a deploy fails without them.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
# Optional: publish the admin UI at <LITELLM_SUBDOMAIN or litellm>.<HOST>. Routed only when LITELLM_ACCESS_AUD (the Audience tag of
# its own Cloudflare Access application) is set, together with CF_ACCESS_TEAM. Repository variables in the deployed stack.
LITELLM_SUBDOMAIN=
LITELLM_ACCESS_AUD=
# Host loopback port for the admin UI at http://localhost:<port>/ui (default 4010). Never routed through the tunnel.
LITELLM_PORT=

# Grafana MCP (read-only). The service-account token should belong to a Viewer service account; the server token is any random
# value (openssl rand -hex 32) that the hub presents as a bearer token. Both are required: a deploy fails without them.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
MCP_GRAFANA_SERVER_TOKEN=
# Optional: where the container reaches Grafana (default http://host.docker.internal:3030).
GRAFANA_MCP_URL=

# Your domain (e.g. example.com). When set, dsh is published at <DSH_SUBDOMAIN or dsh>.<HOST> through the tunnel,
# and dsh trusts that Host. Leave empty locally, and until the hostname's Cloudflare Access policy exists.
HOST=
# Optional subdomain override (default: dsh).
DSH_SUBDOMAIN=

# Optional origin check, both or neither. Zero Trust team name (the <team> in <team>.cloudflareaccess.com) and the dsh
# Access application's Audience (AUD) tag (Access controls > Applications > Configure > Additional settings). With
# both set, cloudflared itself rejects requests that did not pass Access. Repository variables in the deployed stack.
CF_ACCESS_TEAM=
DSH_ACCESS_AUD=

# Host loopback port the gateway publishes (default 3080).
DSH_PORT=

# Host folder the agent may read and write (default ./workspaces next to this file).
DSH_WORKSPACES_DIR=
