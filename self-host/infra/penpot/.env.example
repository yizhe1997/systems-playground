# Environment variables for Penpot.
# Copy to .env on the host and fill in real values — .env is gitignored, this file is not.

# Your domain, e.g. example.com. Required — not shared/global. Per docs/DEPLOYMENT.md, every
# service persists its own copy of HOST in its own .env, because wsl-startup.sh runs a bare
# `docker compose up -d` per service with nothing injected from outside. Every public hostname
# in the repo is built from this (<subdomain>.<HOST>), same convention as every other service.
HOST=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

PENPOT_POSTGRES_PASSWORD=

# Optional overrides
# PENPOT_SUBDOMAIN=penpot
# PENPOT_HOST=penpot.example.com
# PENPOT_VERSION=2.18
