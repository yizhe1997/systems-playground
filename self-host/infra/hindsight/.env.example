# Environment variables for hindsight.
# Copy to .env on the host and fill in real values — .env is gitignored, this file is not.
# In CI these come from Infisical (prod) and repository variables; this file is for local runs.

# Secrets (Infisical in CI)
HINDSIGHT_POSTGRES_PASSWORD=
# Bearer key every client must send. Generate one: openssl rand -hex 32
HINDSIGHT_TENANT_API_KEY=
# Key for the LLM that extracts facts. Use a dedicated key with a spend limit.
HINDSIGHT_LLM_API_KEY=

# Not secret. Setting HOST publishes <HINDSIGHT_SUBDOMAIN>.<HOST> through the Cloudflare tunnel.
HOST=
# HINDSIGHT_SUBDOMAIN=memory

# Control Plane UI at <HINDSIGHT_UI_SUBDOMAIN>.<HOST>, published only when BOTH of these are set
# (the Cloudflare Access application's Audience tag, and your Zero Trust team name). See README.
# HINDSIGHT_UI_ACCESS_AUD=
# CF_ACCESS_TEAM=
# HINDSIGHT_UI_SUBDOMAIN=memory-ui

# Optional LLM overrides (defaults: OpenRouter + DeepSeek, same model dsh uses)
# HINDSIGHT_LLM_PROVIDER=openai
# HINDSIGHT_LLM_BASE_URL=https://openrouter.ai/api/v1
# HINDSIGHT_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Consolidation model only (it inherits the provider, base URL and key above)
# HINDSIGHT_CONSOLIDATION_LLM_MODEL=deepseek/deepseek-v4-flash-0731
